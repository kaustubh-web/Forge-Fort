PORT=4000
MONGODB_URI=mongodb+srv://<db_username>:password@cluster0.m2uhkel.mongodb.net/
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Encrypts saved secrets. 64 hex chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it makes every saved secret unreadable (users must re-enter them).
SECRETS_KEY=
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
MAX_NODES=50
MAX_EDGES=100
DEBUG_ENGINE=false

# Rate limits and proxy (defaults shown). TRUST_PROXY = proxy hops in front of the app:
# 0 locally, 1 on Render/Railway.
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=600
EXECUTE_RATE_LIMIT=30
MAX_CONCURRENT_RUNS=3
TRUST_PROXY=0

# Engine limits (defaults shown)
NODE_TIMEOUT_MS=30000
WORKFLOW_TIMEOUT_MS=300000
HTTP_MAX_RESPONSE_BYTES=1048576
HTTP_MAX_REDIRECTS=5

# AI provider (optional). Leave AI_PROVIDER empty to run without AI nodes.
# gemini -> GEMINI_API_KEY (Google AI Studio). openai -> OPENAI_API_KEY (platform.openai.com).
# AI_MODEL: copy a model id from the provider's official model list.
AI_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
AI_OUTPUT_RETRIES=2
